# Local-only defaults. Replace every credential before exposing services.
VISORAFT_HTTP_ADDR=:8080
VISORAFT_DATABASE_URL=postgres://visoraft:visoraft-local@postgres:5432/visoraft?sslmode=disable
VISORAFT_RABBITMQ_URL=amqp://visoraft:visoraft-local@rabbitmq:5672/
VISORAFT_EVENT_EXCHANGE=visoraft.events
VISORAFT_S3_ENDPOINT=http://seaweedfs:8333
VISORAFT_S3_REGION=us-east-1
VISORAFT_S3_BUCKET=visoraft-media
VISORAFT_S3_ACCESS_KEY=visoraft-local
VISORAFT_S3_SECRET_KEY=visoraft-local-secret
VISORAFT_LOG_LEVEL=info
VISORAFT_COOKIE_ENCRYPTION_KEY=dmlzb3JhZnQtbG9jYWwtY29va2llLWtleS0wMDAwMDE=
VISORAFT_WORKER_TOKEN=visoraft-local-worker-token-2026
# 本地媒体库宿主机绝对路径。也可在设置页面填写后运行 scripts/local.ps1 storage 应用。
VISORAFT_LIBRARY_HOST_PATH=D:/Visoraft媒体库
# yt-dlp 下载调优：HTTP 分块可改善部分站点的限速，并发值仅作用于分片媒体。
VISORAFT_YTDLP_HTTP_CHUNK_SIZE_BYTES=10485760
VISORAFT_YTDLP_CONCURRENT_FRAGMENTS=4
VISORAFT_DOWNLOAD_STALL_TIMEOUT_SECONDS=180
VISORAFT_DOWNLOAD_TIMEOUT_SECONDS=7200
